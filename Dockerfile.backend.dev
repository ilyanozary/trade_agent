FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r requirements.txt \
  && python -c "import cryptography; print('cryptography', cryptography.__version__)"
COPY . .
RUN chmod +x docker/backend-entrypoint.sh
EXPOSE 5000
ENTRYPOINT ["docker/backend-entrypoint.sh"]
CMD ["flask", "--app", "run.py", "run", "--debug", "--host", "0.0.0.0", "--port", "5000"]
